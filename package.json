{
  "name": "@miliastry/quasar",
  "version": "1.2.0",
  "description": "Quasar Document Engine - Advanced BBCode/Markdown/HTML AST Engine",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "license": "MSL-1.0",
  "sideEffects": [
    "./src/Visuals/*.css",
    "./dist/Visuals/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./Visuals/lyne.css": "./dist/Visuals/lyne.css",
    "./Visuals/osu.css": "./dist/Visuals/osu.css",
    "./dist/Visuals/*": "./dist/Visuals/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "prepublishOnly": "npm run verify && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "!src/Tests",
    "!src/**/__tests__",
    "!src/**/*.test.ts"
  ],
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
