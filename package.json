{
  "name": "@miliastry/quasar",
  "version": "1.0.0",
  "description": "Quasar Document Engine - Advanced BBCode/Markdown/HTML AST Engine",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MSL-1.0",
  "sideEffects": [
    "./src/Visuals/*.css",
    "./dist/Visuals/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./Visuals/lyne.css": "./dist/Visuals/lyne.css",
    "./Visuals/osu.css": "./dist/Visuals/osu.css",
    "./dist/Visuals/*": "./dist/Visuals/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "prepublishOnly": "npm run verify && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run typecheck && npm run test"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {},
  "devDependencies": {
    "@miliastry/quasar-studio": "*",
    "tsup": "^8.5.1",
    "typescript": "5.7.3"
  }
}
